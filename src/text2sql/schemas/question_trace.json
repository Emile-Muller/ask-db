{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "question-trace.schema.json",
  "title": "/question pipeline trace",
  "description": "One run of `python -m text2sql run` / `context` (src/text2sql/trace.py). This file IS the structural contract: trace.append checks the exact JSON line against it, plus the rules between fields in trace.cross_checks, before writing to questions/logs/questions/; a trace that fails is neither logged nor printed (exit 1). rows.maxItems mirrors config.PREVIEW_ROWS and stages has len(trace.LAYERS) items, kept equal by a test.",
  "type": "object",
  "required": ["id", "timestamp", "input", "input_type", "verdict", "refused_by", "reason", "stages", "generated_sql", "normalized_sql", "result", "meta"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "description": "uuid4 hex.",
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "minLength": 32,
      "maxLength": 32
    },
    "timestamp": {
      "description": "UTC, ISO 8601, seconds.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\+00:00$",
      "minLength": 25,
      "maxLength": 25
    },
    "input": {
      "description": "The raw input (question, or SQL on the raw-SQL path), before layer 1.",
      "type": "string"
    },
    "input_type": {
      "enum": ["natural_language", "raw_sql"]
    },
    "verdict": {
      "enum": ["accepted", "refused", "error"]
    },
    "refused_by": {
      "description": "The layer that refused (or crashed); null when accepted.",
      "enum": ["input_screen", "generation", "validator", "executor", "output_check", null]
    },
    "reason": {
      "type": ["string", "null"]
    },
    "stages": {
      "description": "Always one per layer, in layer order (order checked by trace.cross_checks).",
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["layer", "name", "status", "duration_ms", "details"],
        "additionalProperties": false,
        "properties": {
          "layer": {"enum": [1, 2, 3, 4, 5]},
          "name": {"enum": ["input_screen", "generation", "validator", "executor", "output_check"]},
          "status": {"enum": ["pass", "fail", "skipped"]},
          "duration_ms": {"type": "integer", "minimum": 0},
          "details": {"type": "object"}
        }
      }
    },
    "generated_sql": {
      "description": "SQL proposed by the model (null on the raw-SQL path or when generation refused).",
      "type": ["string", "null"]
    },
    "normalized_sql": {
      "description": "SQL that passed the validator and was executed.",
      "type": ["string", "null"]
    },
    "result": {
      "type": ["object", "null"],
      "required": ["columns", "rows", "row_count", "truncated"],
      "additionalProperties": false,
      "properties": {
        "columns": {
          "type": "array",
          "items": {"type": "string"}
        },
        "rows": {
          "description": "Preview rows (at most config.PREVIEW_ROWS = 20), JSON-safe values.",
          "type": "array",
          "maxItems": 20,
          "items": {"type": "array"}
        },
        "row_count": {
          "description": "Rows fetched.",
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "description": "True when the preview is shorter than row_count.",
          "type": "boolean"
        }
      }
    },
    "meta": {
      "type": "object",
      "required": ["model", "git_commit"],
      "additionalProperties": false,
      "properties": {
        "model": {"type": ["string", "null"]},
        "git_commit": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "accepted"}}},
      "then": {
        "properties": {
          "refused_by": {"const": null},
          "reason": {"const": null},
          "normalized_sql": {"type": "string"},
          "result": {"type": "object"}
        }
      }
    },
    {
      "if": {"properties": {"verdict": {"const": "refused"}}},
      "then": {
        "properties": {
          "refused_by": {"type": "string"},
          "reason": {"type": "string"},
          "result": {"const": null}
        }
      }
    },
    {
      "if": {"properties": {"verdict": {"const": "error"}}},
      "then": {
        "properties": {
          "reason": {"type": "string"},
          "result": {"const": null}
        }
      }
    }
  ]
}
